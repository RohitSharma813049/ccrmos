# NextAuth Secret Configuration
# Generate a secret via: openssl rand -base64 32
NEXTAUTH_SECRET=super-secret-key-please-change
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Configuration (For SaaS Subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Database Configuration
# Requires MongoDB 5.0+
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/crmos

# OAuth Providers (Optional but recommended)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email Configuration (Nodemailer)
EMAIL_SERVER_HOST=smtp.sendgrid.net
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=apikey
EMAIL_SERVER_PASSWORD=your_sendgrid_api_key
EMAIL_FROM=noreply@crmos.com

# Twilio Configuration (For Dialer & Telephony)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_TWIML_APP_SID=your_twilio_twiml_app_sid
TWILIO_API_KEY=your_twilio_api_key
TWILIO_API_SECRET=your_twilio_api_secret

# Redis Configuration (Optional for caching/Websockets)
# REDIS_URL=redis://localhost:6379
